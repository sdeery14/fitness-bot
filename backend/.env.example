# Database Configuration
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=fitness_pass_dev
POSTGRES_DB=fitness_bot
DATABASE_URL=postgresql+asyncpg://fitness_user:fitness_pass_dev@postgres:5432/fitness_bot

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-5.1  # Model for all AI agents (gpt-5.1, gpt-4o, gpt-4o-mini)

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# USDA FoodData Central API
USDA_API_KEY=your_usda_api_key_here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
